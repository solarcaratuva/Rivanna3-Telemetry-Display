<screen permanent="true">
    <view extends="lv_obj" scrollable="false">
        <style name="dashboard_screen" />

        <!-- ===== Header ===== -->
        <lv_label x="24" y="14" text="DIAGNOSTICS"><style name="value" /></lv_label>
        <lv_button x="-24" y="12" align="top_right" width="128" height="40">
            <style name="nav_ghost" />
            <style name="nav_ghost_pressed" selector="pressed" />
            <lv_label align="center" text="‹  DRIVER" />
            <screen_load_event screen="driver" trigger="clicked" anim_type="move_right" duration="250" />
        </lv_button>

        

        <lv_label x="24" y="60" bind_text="dbg_status">
            <style name="status_chip" />
            <bind_style name="status_chip_bad" subject="telemetry_status" ref_value="0" />
        </lv_label>
        <lv_label x="170" y="64"
            width="480" height="30"
            align="top_mid"
            bind_text="dbg_uptime">
        <style name="dbg_caption" />
        </lv_label>
        <lv_obj x="24" y="98" width="432" height="1" scrollable="false"><style name="hairline" /></lv_obj>

        <!-- ===== Left column: motor controller ===== -->
        <lv_label x="28" y="112" text="MOTOR CONTROLLER"><style name="caption" /></lv_label>
        <dbg_row x="24" y="136" width="210" caption="RPM" subject="dbg_rpm" />
        <dbg_row x="24" y="158" width="210" caption="Speed" subject="dbg_speed" />
        <dbg_row x="24" y="180" width="210" caption="Bus voltage" subject="dbg_mc_voltage" />
        <dbg_row x="24" y="202" width="210" caption="Bus current" subject="dbg_mc_current" />
        <dbg_row x="24" y="224" width="210" caption="Current dir" subject="dbg_mc_direction" />
        <dbg_row x="24" y="246" width="210" caption="Motor current" subject="dbg_motor_current" />
        <dbg_row x="24" y="268" width="210" caption="FET temp" subject="dbg_fet_temp" />
        <dbg_row x="24" y="290" width="210" caption="PWM duty" subject="dbg_pwm_duty" />
        <dbg_row x="24" y="312" width="210" caption="Lead angle" subject="dbg_lead_angle" />
        <dbg_row x="24" y="334" width="210" caption="Fault" subject="dbg_motor_error" alert_subject="motor_status" />

        <!-- ===== Right column: battery ===== -->
        <lv_label x="250" y="112" text="BATTERY"><style name="caption" /></lv_label>
        <dbg_row x="246" y="136" width="210" caption="Pack voltage" subject="dbg_pack_voltage" />
        <dbg_row x="246" y="158" width="210" caption="Pack current" subject="dbg_pack_current" />
        <dbg_row x="246" y="180" width="210" caption="State of charge" subject="dbg_soc" />
        <dbg_row x="246" y="202" width="210" caption="Power" subject="dbg_power" />
        <dbg_row x="246" y="224" width="210" caption="Discharge relay" subject="dbg_discharge_relay" />
        <dbg_row x="246" y="246" width="210" caption="Charge relay" subject="dbg_charge_relay" />
        <dbg_row x="246" y="268" width="210" caption="Charger safety" subject="dbg_charger_safety" />
        <dbg_row x="246" y="290" width="210" caption="Charge signal" subject="dbg_charge_signal" />
        <dbg_row x="246" y="312" width="210" caption="Balancing" subject="dbg_balancing" />
        <dbg_row x="246" y="334" width="210" caption="Aux battery" subject="dbg_aux" />
        <dbg_row x="246" y="356" width="210" caption="Fault" subject="dbg_bps_error" alert_subject="bps_status" />

        <!-- ===== Left column: driver input ===== -->
        <lv_label x="28" y="400" text="DRIVER INPUT"><style name="caption" /></lv_label>
        <dbg_row x="24" y="424" width="210" caption="Throttle pedal" subject="dbg_throttle_pedal" />
        <dbg_row x="24" y="446" width="210" caption="Brake pedal" subject="dbg_brake_pedal" />
        <dbg_row x="24" y="468" width="210" caption="Throttle cmd" subject="dbg_throttle" />
        <dbg_row x="24" y="490" width="210" caption="Regen cmd" subject="dbg_regen_brake" />
        <dbg_row x="24" y="512" width="210" caption="Cruise speed" subject="dbg_cruise_speed" />
        <dbg_row x="24" y="534" width="210" caption="Drive mode" subject="dbg_drive_mode" />

        <!-- ===== Right column: steering wheel switches ===== -->
        <lv_label x="250" y="400" text="SWITCHES"><style name="caption" /></lv_label>
        <lv_label x="246" y="424" width="99" height="40" text="LEFT">
            <style name="chip" /><bind_style name="chip_on" subject="left_status" ref_value="1" />
        </lv_label>
        <lv_label x="357" y="424" width="99" height="40" text="RIGHT">
            <style name="chip" /><bind_style name="chip_on" subject="right_status" ref_value="1" />
        </lv_label>
        <lv_label x="246" y="472" width="99" height="40" text="HAZARD">
            <style name="chip" /><bind_style name="chip_on" subject="hazards_status" ref_value="1" />
        </lv_label>
        <lv_label x="357" y="472" width="99" height="40" text="LOW PWR">
            <style name="chip" /><bind_style name="chip_on" subject="low_power_status" ref_value="1" />
        </lv_label>
        <lv_label x="246" y="520" width="99" height="40" text="CRUISE">
            <style name="chip" /><bind_style name="chip_on" subject="cruise_status" ref_value="1" />
        </lv_label>
        <lv_label x="357" y="520" width="99" height="40" text="REGEN">
            <style name="chip" /><bind_style name="chip_on" subject="regen_status" ref_value="1" />
        </lv_label>
        <lv_label x="246" y="568" width="99" height="40" text="CRUISE +">
            <style name="chip" /><bind_style name="chip_on" subject="cruise_up_status" ref_value="1" />
        </lv_label>
        <lv_label x="357" y="568" width="99" height="40" text="CRUISE -">
            <style name="chip" /><bind_style name="chip_on" subject="cruise_down_status" ref_value="1" />
        </lv_label>

        <!-- ===== Fault log ===== -->
        <lv_obj x="24" y="640" width="432" height="136" scrollable="false">
            <style name="panel" />
            <lv_label x="14" y="14" text="ACTIVE FAULTS"><style name="caption" /></lv_label>
            <lv_label x="200" y="11" bind_text="dbg_fault_count">
                <style name="badge" />
                <bind_style name="badge_fault" subject="fault_active" ref_value="1" />
            </lv_label>
            <lv_label x="14" y="48" width="404" long_mode="clip" bind_text="dbg_fault_1">
                <style name="dbg_caption" />
                <bind_style name="dbg_value_alert" subject="fault_active" ref_value="1" />
            </lv_label>
            <lv_label x="14" y="74" width="404" long_mode="clip" bind_text="dbg_fault_2">
                <style name="dbg_caption" />
                <bind_style name="dbg_value_alert" subject="fault_active" ref_value="1" />
            </lv_label>
            <lv_label x="14" y="100" width="404" long_mode="clip" bind_text="dbg_fault_3">
                <style name="dbg_caption" />
                <bind_style name="dbg_value_alert" subject="fault_active" ref_value="1" />
            </lv_label>
        </lv_obj>

        <!-- ===== PRECHARGE DROPDOWN PANEL ===== -->
        <lv_obj name="precharge_dropdown"
            x="24" y="104"
            width="432" height="660"
            scrollable="false">

            <style name="panel" />

            <bind_flag_if_eq
                subject="precharge_panel_open"
                flag="hidden"
                ref_value="0" />

            <!-- Panel header -->
            <lv_label x="16" y="12"
                    text="PRECHARGE SYSTEM">
                <style name="value" />
            </lv_label>

            <!-- Close button -->
            <lv_button x="-14" y="8"
                    align="top_right"
                    width="64" height="36">

                <style name="nav_ghost" />
                <style name="nav_ghost_pressed" selector="pressed" />

                <lv_label align="center" text="X" />

                <subject_set_int_event
                    trigger="clicked"
                    subject="precharge_panel_open"
                    value="0" />
            </lv_button>

            <!-- Overall status -->
            <lv_label x="16" y="54"
                    width="390" height="30"
                    bind_text="pre_status">
                <style name="status_chip" />
            </lv_label>

            <lv_obj x="16" y="92"
                    width="400" height="1"
                    scrollable="false">
                <style name="hairline" />
            </lv_obj>

            <!-- PRECHARGE STAGES -->
            <lv_label x="16" y="106"
                    text="PRECHARGE STAGES">
                <style name="caption" />
            </lv_label>

            <!-- Motor stage -->
            <lv_obj x="16" y="132"
                    width="192" height="100"
                    scrollable="false">
                <style name="panel" />
                <lv_label x="12" y="10" text="MOTOR">
                    <style name="caption" />
                </lv_label>
                <lv_label x="12" y="38"
                        width="168" height="48"
                        bind_text="pre_motor_stage">
                    <style name="label_28" />
                </lv_label>
            </lv_obj>

            <!-- MPPT stage -->
            <lv_obj x="224" y="132"
                    width="192" height="100"
                    scrollable="false">
                <style name="panel" />
                <lv_label x="12" y="10" text="MPPT">
                    <style name="caption" />
                </lv_label>
                <lv_label x="12" y="38"
                        width="168" height="48"
                        bind_text="pre_mppt_stage">
                    <style name="label_28" />
                </lv_label>
            </lv_obj>

            <!-- FAULT / CONTACTOR STATUS -->
            <lv_label x="16" y="246"
                    text="FAULT / CONTACTOR STATUS">
                <style name="caption" />
            </lv_label>

            <lv_obj x="16" y="274"
                    width="400" height="142"
                    scrollable="false">
                <style name="panel" />

                <lv_label x="12" y="10"
                        text="CONTACTOR 12 FAULT">
                    <style name="dbg_caption" />
                </lv_label>
                <lv_label x="240" y="10"
                        width="148" height="28"
                        bind_text="pre_cont12_fault">
                    <style name="dbg_value" />
                    <bind_style name="dbg_value_alert"
                                subject="pre_cont12_fault_active"
                                ref_value="1" />
                </lv_label>

                <lv_obj x="12" y="42"
                        width="376" height="1"
                        scrollable="false">
                    <style name="hairline" />
                </lv_obj>

                <lv_label x="12" y="50"
                        text="OTHER FAULT">
                    <style name="dbg_caption" />
                </lv_label>
                <lv_label x="240" y="50"
                        width="148" height="28"
                        bind_text="pre_other_fault">
                    <style name="dbg_value" />
                    <bind_style name="dbg_value_alert"
                                subject="pre_other_fault_active"
                                ref_value="1" />
                </lv_label>

                <lv_obj x="12" y="82"
                        width="376" height="1"
                        scrollable="false">
                    <style name="hairline" />
                </lv_obj>

                <lv_label x="12" y="90"
                        text="CONTACTOR 12">
                    <style name="dbg_caption" />
                </lv_label>
                <lv_label x="240" y="90"
                        width="148" height="28"
                        bind_text="pre_cont12">
                    <style name="dbg_value" />
                </lv_label>
            </lv_obj>

            <!-- PRECHARGE MEASUREMENTS -->
            <lv_label x="16" y="430"
                    text="PRECHARGE MEASUREMENTS">
                <style name="caption" />
            </lv_label>

            <lv_obj x="16" y="458"
                    width="400" height="174"
                    scrollable="false">
                <style name="panel" />

                <lv_label x="12" y="10"
                        text="THRESHOLD">
                    <style name="dbg_caption" />
                </lv_label>
                <lv_label x="220" y="10"
                        width="168" height="28"
                        bind_text="pre_threshold">
                    <style name="dbg_value" />
                </lv_label>

                <lv_obj x="12" y="42"
                        width="376" height="1"
                        scrollable="false">
                    <style name="hairline" />
                </lv_obj>

                <lv_label x="12" y="50"
                        text="MOTOR HALL EFFECT">
                    <style name="dbg_caption" />
                </lv_label>
                <lv_label x="220" y="50"
                        width="168" height="28"
                        bind_text="pre_hall_motor">
                    <style name="dbg_value" />
                </lv_label>

                <lv_obj x="12" y="82"
                        width="376" height="1"
                        scrollable="false">
                    <style name="hairline" />
                </lv_obj>

                <lv_label x="12" y="90"
                        text="MPPT HALL EFFECT">
                    <style name="dbg_caption" />
                </lv_label>
                <lv_label x="220" y="90"
                        width="168" height="28"
                        bind_text="pre_hall_mppt">
                    <style name="dbg_value" />
                </lv_label>

                <lv_obj x="12" y="122"
                        width="376" height="1"
                        scrollable="false">
                    <style name="hairline" />
                </lv_obj>

                <lv_label x="12" y="130"
                        text="CAN ID 0x258">
                    <style name="caption" />
                </lv_label>
                <lv_label x="220" y="130"
                        width="168" height="28"
                        bind_text="pre_frame_status">
                    <style name="dbg_value" />
                </lv_label>
            </lv_obj>

        </lv_obj>
        <!-- ===== END PRECHARGE DROPDOWN ===== -->

        <!-- Reopen precharge panel button -->
        <lv_button x="-24" y="56"
                align="top_right"
                width="140" height="30">

            <style name="nav_ghost" />
            <style name="nav_ghost_pressed" selector="pressed" />

            <lv_label align="center" text="PRECHARGE">
                <style name="dbg_caption" />
            </lv_label>

            <subject_set_int_event
                trigger="clicked"
                subject="precharge_panel_open"
                value="1" />

            <bind_flag_if_eq
                subject="precharge_panel_open"
                flag="hidden"
                ref_value="1" />
        </lv_button>
    </view>
</screen>
